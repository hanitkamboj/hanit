# API Keys - Fill in your credentials
# Get these from respective platforms

# Genius API (https://genius.com/api-clients)
GENIUS_ACCESS_TOKEN=your_genius_token_here

# Spotify API (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Unsplash API (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your_unsplash_key

# Pexels API (https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_key

# YouTube Data API (https://console.cloud.google.com/apis/credentials)
# Place your client_secrets.json file in the root directory

# Optional: Google Custom Search API for background images
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CX=your_custom_search_engine_id
